<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml: app identity, permissions and the single activity.

  Permission rationale: docs/DESIGN.md §9 (Permissions) and permissions/BlePermissions.kt.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ===== Bluetooth: Android 11 and lower (API <= 30) =====
         Legacy install-time permissions, replaced by SCAN/CONNECT on API 31+.
         maxSdkVersion keeps them from showing up on newer devices. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />
    <!-- Before API 31, BLE scan results count as location data, so fine
         location is required (runtime-requested in BlePermissions). -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- ===== Bluetooth: Android 12 and higher (API 31+) ===== -->
    <!-- neverForLocation: we don't derive the user's location from scans, so
         no location permission is needed on API 31+. (Side effect: Android may
         filter out beacon-type adverts, which our device doesn't send.) -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <!-- Needed to connect over GATT and to read device names. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- ===== Wi-Fi / network state (normal permissions, granted at install) =====
         Not used directly by our code, but the Espressif library calls
         WifiManager/ConnectivityManager APIs internally (e.g. reading the
         phone's current SSID after connecting), and those need these
         permissions or they throw SecurityException. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The app is useless without BLE, so Play Store hides it on devices without BLE. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BleWifiProvisioning">
        <!-- allowBackup=false: nothing worth backing up, and it avoids restoring stale state. -->

        <!-- Single-activity app: every screen is a Compose destination (ui/navigation/AppNavHost.kt). -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
