<?xml version="1.0" encoding="utf-8"?>
<!--
  ic_launcher.xml: adaptive launcher icon (API 26+, which is our minSdk, so
  no PNG fallbacks are needed). The launcher masks the layers to its own shape
  (circle, squircle, ...). The monochrome layer is used for themed icons on Android 13+.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
